#!/usr/bin/env bash
# fg: drive Feedback Graph from a terminal or an agent (status, projects, scans, Inbox, lessons, links, facts, docs,
# activity, sessions, cloud sync, integrations).
#   ./scripts/fg --help
#   ./scripts/fg status --until idle --timeout 600
#   ./scripts/fg projects select --key acme,demo-shop
#   ./scripts/fg scan --all --wait
#   ./scripts/fg inbox list ; ./scripts/fg inbox reject <id> --reason "bot comment"
#   ./scripts/fg doctor                      the host checks (./scripts/doctor.sh)
#   ./scripts/fg setup --yes                 ./scripts/setup.sh with those arguments
#
# Owner decisions need FG_OPERATOR_TOKEN (from the environment, else .env); the API allows only the verbs OPERATOR_ALLOW
# names (by default not deciding lessons, deleting data, importing or integration keys). The token is passed to the CLI in its environment, never printed.
# Runs packages/api/src/cli.ts with the host's Node (22.18+ or 23.6+, which run TypeScript natively); without one, inside
# the api container (docker compose exec api node src/cli.ts ...), which has the same settings from .env.
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
# The host checks (Docker, ports, Ollama, mounts) are not an API call: they run here, with or without Node.
if [ "${1:-}" = doctor ]; then shift; exec "$here/scripts/doctor.sh" "$@"; fi
# Setup (Docker, .env, models, the stack) is the host's job too: never inside the api container.
if [ "${1:-}" = setup ]; then shift; exec "$here/scripts/setup.sh" "$@"; fi
env_file="${FEEDBACK_GRAPH_ENV:-$here/.env}"
# KEY's value: the environment's when set, else the last KEY= line of the env file, surrounding quotes removed.
setting() {
  local v
  v="$(printenv "$1" 2>/dev/null || true)"
  if [ -z "$v" ] && [ -f "$env_file" ]; then
    v="$(grep -E "^$1=" "$env_file" | tail -n 1 | cut -d= -f2- | sed -e "s/^[\"']//" -e "s/[\"']\$//" || true)"
  fi
  printf '%s' "$v"
}

# Containers under this folder's Compose name (FG_INSTANCE) that another folder started are that folder's install: the
# API answering here (and docker compose exec) is that one, not this checkout. Said on stderr before every command.
if command -v docker >/dev/null 2>&1; then
  instance="$(setting FG_INSTANCE)"; instance="${instance:-feedback-graph}"
  started_in="$(docker ps -a --filter "label=com.docker.compose.project=$instance" --format '{{.Label "com.docker.compose.project.working_dir"}}' 2>/dev/null | head -n 1 || true)"
  if [ -n "$started_in" ] && [ "$(cd "$started_in" 2>/dev/null && pwd -P || printf '%s' "$started_in")" != "$(cd "$here" && pwd -P)" ]; then
    {
      echo "WARNING: the containers named $instance were started from $started_in, not this folder ($here): the API answering"
      echo "  is that install's, and docker compose here would take it over. Give this folder its own FG_INSTANCE and ports"
      echo "  in .env (./scripts/setup.sh --help), or run fg from $started_in."
    } >&2
  fi
fi

native_ts() {
  command -v node >/dev/null 2>&1 &&
    node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>23||(a===23&&b>=6)||(a===22&&b>=18)?0:1)' 2>/dev/null
}

if native_ts; then
  if [ -z "${FEEDBACK_GRAPH_URL:-}" ]; then
    port="$(setting API_PORT)"
    export FEEDBACK_GRAPH_URL="http://localhost:${port:-8787}"
  fi
  FG_OPERATOR_TOKEN="$(setting FG_OPERATOR_TOKEN)" API_TOKEN="$(setting API_TOKEN)" \
    exec node "$here/packages/api/src/cli.ts" "$@"
fi

if command -v docker >/dev/null 2>&1; then
  # Inside the container the API is on localhost:8787 and FG_OPERATOR_TOKEN comes from compose (.env).
  exec docker compose --project-directory "$here" exec -T ${FG_OPERATOR_NAME:+-e FG_OPERATOR_NAME="$FG_OPERATOR_NAME"} api node src/cli.ts "$@"
fi

echo "fg needs Node 22.18+ (or 23.6+) on the host, or docker to run it inside the api container" >&2
exit 1
