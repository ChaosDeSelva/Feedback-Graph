# Feedback Graph configuration. Copy to .env (or run ./scripts/setup.sh, which fills in the paths and a password).
# Every setting is checked at startup; a bad value stops the service with a message naming it.

# --- Required ---------------------------------------------------------------------------------------------
NEO4J_PASSWORD=change-me-please

# --- Storage ----------------------------------------------------------------------------------------------
# neo4j (default) or postgres. For postgres with the bundled service, also set COMPOSE_PROFILES=postgres below.
STORE=neo4j
# The bundled postgres service's password (letters and digits only: it goes in a URL). Used only with STORE=postgres
# and an empty DATABASE_URL; startup refuses an empty one.
POSTGRES_PASSWORD=
# With STORE=postgres and the bundled service: COMPOSE_PROFILES=postgres makes every docker compose command (up, down,
# logs, ps) include the database, so you never need --profile postgres. Leave empty for Neo4j or your own server.
COMPOSE_PROFILES=
# Host port of the bundled postgres service (bound to 127.0.0.1).
POSTGRES_PORT=5434
# Your own Postgres 17 + pgvector instead of the bundled service. Empty = the bundled one.
DATABASE_URL=

# --- Where things are (host paths) ------------------------------------------------------------------------
# The folder holding your projects, one folder per project. Sessions in the folders you select in Settings are read.
PROJECTS_DIR=/Users/you/code
# More than one projects folder: all of them, comma-separated (the first is PROJECTS_DIR). Then re-run
# ./scripts/setup.sh: it mounts them through a generated docker-compose.override.yml. Empty: just PROJECTS_DIR.
PROJECTS_DIRS=
# This repository (for the bundled examples/demo-shop).
FEEDBACK_TOOL_DIR=/Users/you/feedback_tool
# Your Codex login, only if you use the codex-cli provider (setup.sh sets it when ~/.codex/auth.json exists).
CODEX_AUTH_FILE=
# Codex CLI / Desktop session transcripts (default ~/.codex/sessions). Only sessions in folders you select are read.
CODEX_SESSIONS_DIR=

# --- Scope ------------------------------------------------------------------------------------------------
# You choose which project folders are read in the UI (Settings); nothing is read until you do.
# INGEST_PROJECTS (comma-separated) only seeds that choice on the very first start; after that, Settings decides.
INGEST_PROJECTS=
# Never read, scan or serve these, whatever is selected (client work, anything sensitive). Settings cannot override it.
EXCLUDE_PROJECTS=
# Days to keep the words of turns nobody flagged. Flagged sessions are kept whole. Empty = keep everything.
TURN_RETENTION_DAYS=
# Claude Code feedback memories are imported as proposed lessons for you to approve. true: approve them on import.
MEMORY_AUTO_APPROVE=false

# --- Pace and bounds (empty = the default) ----------------------------------------------------------------
# Seconds between worker cycles (default 30).
POLL_SECONDS=
# Turns classified per cycle (default 50).
CLASSIFY_BATCH=
# Files per project the code map and scans look at (default 400), and the largest file they read in bytes (default 80000).
SCAN_MAX_FILES=
SCAN_MAX_BYTES=

# --- Models -----------------------------------------------------------------------------------------------
# Free local models via Ollama on the host (ollama pull gemma4 nomic-embed-text).
OLLAMA_MODEL=gemma4
# Changing this after the first run needs a re-embed (the services refuse to start and tell you how).
OLLAMA_EMBED_MODEL=nomic-embed-text
# Per job: ollama:<model>, claude-cli[:model], codex-cli[:model], openai:<model>, openrouter:<model>,
# groq:<model>, anthropic:<model>, jev (CLASSIFY_LLM only). Empty = the local model (post-mortems use
# claude-cli when CLAUDE_CODE_OAUTH_TOKEN is set).
CLASSIFY_LLM=
POSTMORTEM_LLM=
SCAN_LLM=
CHECK_LLM=
# codex-cli can read every file the worker can (all transcripts, every project's .env, the worker's secrets), not just
# the repo; it runs only with ALLOW_UNCONFINED_CODEX=1. See SECURITY.md. claude-cli is confined to the project folder.
ALLOW_UNCONFINED_CODEX=
# claude setup-token -> runs post-mortems on your own Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=
# Bring-your-own keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=

# --- Integrations -----------------------------------------------------------------------------------------
GITHUB_TOKEN=
# project-key=owner/repo pairs whose PR discussions become context.
GITHUB_REPOS=
GITHUB_SYNC_HOURS=6
LINEAR_API_KEY=

# --- Feedback Graph Cloud sync (optional, off by default) ------------------------------------------------
# Push your approved lessons, misses, facts and doc titles to a team org. Nothing is sent unless both are set.
# Create a token with the sync scope in the cloud web app (Access tokens). https only (http only for localhost).
CLOUD_URL=
CLOUD_TOKEN=
# Minutes between automatic syncs (5 or more). Empty: only when you press Sync now in Settings.
SYNC_INTERVAL_MINUTES=
# Comma-separated projects to sync. Empty: every project selected in Settings.
SYNC_PROJECTS=
# false (default): only lessons you approved are sent (plus the new status of any the cloud already has).
# true: proposed lessons you have not approved are sent too, as suggestions for an org admin.
SYNC_SUGGESTIONS=false

# --- Access -----------------------------------------------------------------------------------------------
# Without a token the API only answers on localhost, and any API_BIND but 127.0.0.1 stops it at startup.
# To reach it from other machines (behind TLS):
#   API_TOKEN=$(openssl rand -hex 24)   PUBLIC_HOSTS=feedback.example.com   API_BIND=0.0.0.0
API_TOKEN=
PUBLIC_HOSTS=
API_BIND=127.0.0.1
API_PORT=8787
