# Feedback Graph configuration. Copy to .env (or run ./scripts/setup.sh, which fills in the paths and a password).
# Every setting is checked at startup; a bad value stops the service with a message naming it.

# --- Required ---------------------------------------------------------------------------------------------
NEO4J_PASSWORD=change-me-please

# --- This install -----------------------------------------------------------------------------------------
# The Docker Compose project name: this install's containers, network and volumes (its data) are named after it.
# Empty: feedback-graph, the name of every install before 0.6.2 (so their volumes keep their names). Two checkouts with
# the same name share containers and data, so ./scripts/setup.sh sets a distinct one (and distinct ports below) in a
# new .env when another folder's install already uses it. Changing it later starts with empty volumes: the old data
# stays under the old name (docker volume ls).
FG_INSTANCE=

# --- Storage ----------------------------------------------------------------------------------------------
# neo4j (default) or postgres. For postgres with the bundled service, also set COMPOSE_PROFILES=postgres below.
STORE=neo4j
# The bundled postgres service's password (letters and digits only: it goes in a URL). Used only with STORE=postgres
# and an empty DATABASE_URL; startup refuses an empty one.
POSTGRES_PASSWORD=
# With STORE=postgres and the bundled service: COMPOSE_PROFILES=postgres makes every docker compose command (up, down,
# logs, ps) include the database, so you never need --profile postgres. Leave empty for Neo4j or your own server.
COMPOSE_PROFILES=
# Host port of the bundled postgres service (bound to 127.0.0.1).
POSTGRES_PORT=5434
# Host ports of Neo4j (bound to 127.0.0.1): its browser (default 7476) and bolt (default 7689).
NEO4J_HTTP_PORT=
NEO4J_BOLT_PORT=
# Your own Postgres 17 + pgvector instead of the bundled service. Empty = the bundled one.
DATABASE_URL=

# --- Where things are (host paths) ------------------------------------------------------------------------
# The folders holding your projects (one folder per project inside), comma-separated. There is no default: nothing is
# mounted until you choose. Add or remove them in Settings (Where folders come from), then run ./scripts/setup.sh: it
# writes them here, mounts exactly these folders read-only through a generated docker-compose.override.yml and restarts
# the containers. Settings wins over this line once you have saved roots there. The bundled examples/ folder is a root
# only if you add it.
PROJECTS_DIRS=
# Your Codex login, only if you use the codex-cli provider (setup.sh sets it when ~/.codex/auth.json exists).
CODEX_AUTH_FILE=
# Codex CLI / Desktop session transcripts (default ~/.codex/sessions). Only sessions in folders you select are read.
CODEX_SESSIONS_DIR=
# Claude Code session transcripts (default ~/.claude/projects). Its memory notes are read from here too.
CLAUDE_PROJECTS_DIR=
# Linux: the uid and gid the worker and api run as, so they can write ./state and read your transcripts. setup.sh sets
# them to yours (id -u, id -g). Empty: 1000, the image's own user (macOS and Windows need nothing here).
HOST_UID=
HOST_GID=

# --- Scope ------------------------------------------------------------------------------------------------
# You choose which project folders are read in the UI (Settings); nothing is read until you do.
# INGEST_PROJECTS (comma-separated) only seeds that choice on the very first start; after that, Settings decides.
INGEST_PROJECTS=
# Never read, scan or serve these, whatever is selected (client work, anything sensitive). Settings cannot override it.
EXCLUDE_PROJECTS=
# Days to keep the words of turns nobody flagged. Flagged sessions are kept whole, and while summaries are on a turn is
# kept until its session summary covers it (summaries are never removed). Empty = keep everything.
TURN_RETENTION_DAYS=
# Claude Code feedback memories are imported as proposed lessons for you to approve. true: approve them on import.
MEMORY_AUTO_APPROVE=false

# --- Pace and bounds (empty = the default) ----------------------------------------------------------------
# Seconds between worker cycles (default 30).
POLL_SECONDS=
# Turns classified per cycle (default 50).
CLASSIFY_BATCH=
# Files per project the code map keeps (default: 40% of the files worth mapping, at least 400, at most 4000; source
# and files your sessions edited first) and changed files a scan reads per run (default 400). Set a number to fix both.
SCAN_MAX_FILES=
# The largest file the code map and scans read, in bytes (default 80000).
SCAN_MAX_BYTES=
# Scans run at once, beside the worker cycle (default 2). Agentic scans (codex-cli, claude-cli) run one at a time.
SCAN_CONCURRENCY=

# --- Session summaries (empty = the default) --------------------------------------------------------------
# A session's new turns are summarized once it has been quiet this many minutes (default 10), or at once when this many
# are waiting (default 40). Quiet for SESSION_IDLE_MINUTES (default 30) and summarized: idle, "complete for now".
SUMMARY_QUIET_MINUTES=
SUMMARY_MAX_DELTA_TURNS=
SESSION_IDLE_MINUTES=
# Sessions from before summaries existed, summarized per worker cycle, newest first (default 3; 0 stops the backfill).
SUMMARY_BACKFILL_PER_CYCLE=

# --- Models -----------------------------------------------------------------------------------------------
# Free local models via Ollama on the host (ollama pull gemma4 nomic-embed-text).
# Apple silicon: some Ollama builds serve a tag through their MLX runner (details.runner in Ollama's /api/show), which
# can lack structured output; ./scripts/doctor.sh then fails its probe. A GGUF tag such as gemma4:e4b-it-q4_K_M runs
# on llama.cpp everywhere. The default stays gemma4 because setup cannot tell which runner a tag will get before pulling.
OLLAMA_MODEL=gemma4
# Changing this after the first run needs a re-embed (the services refuse to start and tell you how).
OLLAMA_EMBED_MODEL=nomic-embed-text
# Limits sent with every Ollama chat call: most tokens one answer may run to (empty: each job's own, classify 256,
# relevance scores 1024, everything else 2048; a number here is the limit for every job) and a repeat penalty
# (default 1.1), so a model stuck in a repetition loop stops early instead of running into the timeout.
OLLAMA_NUM_PREDICT=
OLLAMA_REPEAT_PENALTY=
# Context window every chat call asks for (default 16384). Without it Ollama loads the model at its full trained
# context (131072 for gemma4, about 10 GB of memory). Raise it if long post-mortem prompts get cut off.
OLLAMA_NUM_CTX=
# Seconds one Ollama chat call may take; empty: each job's own limit (classify 120, scan 180, documents 300).
# A call that times out counts against that item (skipped after its attempts); it does not pause the batch.
OLLAMA_TIMEOUT_SECONDS=
# Host port of the bundled ollama service (docker compose --profile ollama; bound to 127.0.0.1). Empty: 11435.
OLLAMA_PORT=
# Per job: ollama:<model>, claude-cli[:model], codex-cli[:model], openai:<model>, openrouter:<model>,
# groq:<model>, anthropic:<model>, jev (CLASSIFY_LLM only). Empty = the local model (post-mortems use
# claude-cli when CLAUDE_CODE_OAUTH_TOKEN is set).
CLASSIFY_LLM=
POSTMORTEM_LLM=
SCAN_LLM=
# Reads documents and images you upload on the Projects page into facts. Empty = SCAN_LLM. Images need a model with
# vision: ollama:gemma4, anthropic:, openai:, openrouter: or claude-cli (codex-cli and jev cannot read images).
DOCS_LLM=
# CHECK_LLM judges check_before_done inside the api, which has no agent CLIs: claude-cli and codex-cli are refused here.
CHECK_LLM=
# Session summaries; off = none.
SUMMARY_LLM=
# Ask (the chat page): the default model for chats that do not pick one. Empty = claude-cli when CLAUDE_CODE_OAUTH_TOKEN
# is set (anthropic: with only ANTHROPIC_API_KEY), else codex-cli when a Codex login exists (CODEX_AUTH_FILE, with
# CODEX_RUNNER_URL or ALLOW_UNCONFINED_CODEX=1), else the local model. Each chat can switch between Claude, Codex and
# local. The model gets the question and its context pack (lessons, misses, facts, documents and code snippets of that
# project) and nothing else: no access to the repository.
CHAT_LLM=
# codex-cli, confined: set CODEX_RUNNER_URL=http://codex-runner:8790 and add codex to COMPOSE_PROFILES above
# (COMPOSE_PROFILES=codex, or postgres,codex). Codex then runs in the codex-runner container, which holds only the Codex
# CLI, your Codex login and each job's copy of the repository. See docs/operations.md and SECURITY.md.
CODEX_RUNNER_URL=
# Without CODEX_RUNNER_URL, codex-cli runs inside the worker and can read every file the worker can (all transcripts,
# every project's .env, the worker's secrets), not just the repo; it runs there only with ALLOW_UNCONFINED_CODEX=1.
# claude-cli is confined to the project folder.
ALLOW_UNCONFINED_CODEX=
# claude setup-token -> runs post-mortems on your own Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=
# Bring-your-own keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=

# --- Integrations -----------------------------------------------------------------------------------------
# GitHub and Linear: review comments and issue comments become Inbox items, and PR discussions become context.
# Optional here: you can paste the tokens in Settings > Integrations instead (kept in state/settings/integrations.json,
# mode 600). A token saved in Settings wins over one set here; this one is used when none is saved there.
# GitHub: a fine-grained token, only your projects' repositories, Pull requests and Issues read-only.
GITHUB_TOKEN=
# Linear: a personal API key (Linear: Settings, Security and access).
LINEAR_API_KEY=
# Optional override, project-key=owner/repo pairs. Empty: each selected project's github.com remote is used.
GITHUB_REPOS=
# Hours between PR-as-context refreshes (default 6), and minutes between comment syncs per project (default 10).
GITHUB_SYNC_HOURS=6
INTEGRATION_SYNC_MINUTES=
# Comment authors to treat as bots (never sent to the classifier) or as AI agents (kept, labelled "agent"), comma
# separated. Logins ending in [bot] are always bots; comments opening with [claude], [codex] or [P1]..[P3] are agents.
GITHUB_BOT_LOGINS=
GITHUB_AGENT_LOGINS=
# Minutes between rounds of looking for links between your selected projects (default 30). No model is used.
LINK_SCAN_MINUTES=

# --- Feedback Graph Cloud sync (optional, off by default) ------------------------------------------------
# Push your approved lessons, misses, facts and doc titles to a team org. Nothing is sent unless both are set.
# Create a token with the sync scope in the cloud web app (Access tokens). https only, except plain http to this
# machine: localhost, or http://host.docker.internal:<port> for a cloud running on the host (the containers reach it so).
CLOUD_URL=
CLOUD_TOKEN=
# This machine's name on the cloud's sync log (letters, digits, . _ -). ./scripts/setup.sh fills it from the host name
# when cloud sync is on. Sent only to CLOUD_URL.
CLOUD_MACHINE=
# Minutes between automatic syncs (5 or more). Empty: only when you press Sync now in Settings.
SYNC_INTERVAL_MINUTES=
# Comma-separated projects to sync. Empty: every project selected in Settings.
SYNC_PROJECTS=
# false (default): only lessons you approved are sent (plus the new status of any the cloud already has).
# true: proposed lessons you have not approved are sent too, as suggestions for an org admin.
SYNC_SUGGESTIONS=false

# --- Access -----------------------------------------------------------------------------------------------
# Without a token the API only answers on localhost, and any API_BIND but 127.0.0.1 stops it at startup.
# To reach it from other machines (behind TLS):
#   API_TOKEN=$(openssl rand -hex 24)   PUBLIC_HOSTS=feedback.example.com   API_BIND=0.0.0.0
API_TOKEN=
PUBLIC_HOSTS=
# Operator token: lets an agent or the fg CLI (scripts/fg) make owner decisions without the browser, sent as
# Authorization: Bearer. Empty (default): only the UI can. 24+ chars, different from API_TOKEN; never share it with a
# remote service. Writes made with it are logged as operator:<name> (the X-FG-Operator header, fg --as <name>), and it
# also signs in for reading like API_TOKEN. ./scripts/setup.sh offers to make one (--yes makes it), or:
#   FG_OPERATOR_TOKEN=$(openssl rand -hex 24)
FG_OPERATOR_TOKEN=
# What the operator token may do, comma-separated. Empty: everything except lesson_decide (approving, rejecting or
# editing lessons stays yours), select_projects (which folders are read stays your opt-in), delete_project, docs_delete,
# links_delete (removing a link; links only confirms, dismisses or reopens one), settings (roots and the cleanup that
# deletes data), import, integrations, chat (asking in Ask spends your Claude or Codex subscription) and chat_delete.
# all: everything. Verbs: select_projects, settings, scan, inbox_decide, lesson_decide,
# relevance, pin, links, links_delete, docs, docs_delete, delete_project, retry, requeue, sync_now, import, resummarize, integrations,
# chat (ask in Ask: spends your model subscription), chat_delete, run_cleanup (fg cleanup --run: removes only what one
# labelled test run wrote, so it is on by default)
OPERATOR_ALLOW=
API_BIND=127.0.0.1
API_PORT=8787
